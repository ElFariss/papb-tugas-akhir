#!/usr/bin/env bash
# stdin: <local ref> <local sha> <remote ref> <remote sha>
set -euo pipefail
root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000

while read -r _ local_sha remote_ref remote_sha; do
    [[ $local_sha == "$zero" ]] && continue          # deleting a remote branch
    [[ $remote_ref == refs/heads/* ]] || continue    # tags
    branch=${remote_ref#refs/heads/}

    if [[ $branch == main ]]; then
        # The very first push creates main; after that it only changes through pull requests.
        [[ $remote_sha == "$zero" ]] && continue
        echo "Direct pushes to main are not allowed. Open a pull request." >&2
        exit 1
    fi

    if ! git rev-parse --verify --quiet refs/remotes/origin/main > /dev/null; then
        echo "origin/main is unknown. Run: git fetch origin" >&2
        exit 1
    fi
    if ! git merge-base --is-ancestor origin/main "$local_sha"; then
        echo "'$branch' is behind origin/main. Run: scripts/git/pull.sh" >&2
        exit 1
    fi
    "$root/scripts/git/check.sh" range "$branch" origin/main "$local_sha"
done
